{
  "name": "unified-field-theory-visualization",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite --host --port 3000",
    "dev": "pnpm dev:client",
    "build:client": "vite build --outDir dist/static",
    "build": "pnpm build:client && node -e \"try { require('fs').copyFileSync('package.json', 'dist/package.json'); require('fs').writeFileSync('dist/build.flag', ''); } catch(e) { console.error(e) }\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.1",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "three": "^0.164.1",
    "zod": "^3.24.2",
    "@react-three/fiber": "^8.17.10",
    "@react-three/drei": "^9.114.6",
    "web-worker": "^1.3.0",
    "comlink": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.17"
  }
}
