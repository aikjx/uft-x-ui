{
  "name": "unified-field-theory-visualization",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --https",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/**/*.test.ts src/**/*.test.tsx",
    "test:components": "vitest run src/components/**/*.test.tsx",
    "test:integration": "vitest run src/**/*.integration.test.tsx",
    "test:services": "vitest run src/services/**/*.test.ts",
    "test:utils": "vitest run src/utils/**/*.test.ts",
    "test:benchmark": "vitest run --mode=test:benchmark",
    "test:ui": "vitest --ui",
    "test:report": "vitest run --reporter=verbose --reporter=html",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results/junit.xml",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "clean": "rm -rf dist node_modules/.vite coverage test-results .tsbuildinfo",
    "prepare": "husky && npm run clean && npm install",
    "analyze": "vite build --mode=analyze"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.3.0",
    "three": "^0.170.0",
    "framer-motion": "^12.9.0",
    "recharts": "^2.12.0",
    "mathjax": "^4.0.0",
    "zustand": "^5.0.9",
    "zod": "^3.24.2",
    "sonner": "^2.0.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/dom": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-tailwindcss": "^3.16.0",
    "eslint-plugin-unused-imports": "^4.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.0.0",
    "vitest-canvas-mock": "^1.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "engines": {
    "node": "^20.15.0 || ^22.0.0",
    "pnpm": "^9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.12.3"
}
